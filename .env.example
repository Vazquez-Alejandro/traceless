# TraceLess — Environment Variables
# Copy to .env and fill in real values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
JWT_SECRET=

# WhatsApp Cloud API
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ARCA (ex AFIP)
ARCA_CUIT=20294796577
ARCA_CERT_PATH=certs/cert.pem
ARCA_KEY_PATH=certs/key.pem
ARCA_ENV=produccion
ARCA_USE_REAL=1

# Cron secret (used by Vercel crons)
CRON_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=TraceLess <noreply@traceless.com.ar>
CONTACT_EMAIL=soporte@traceless.com.ar
ADMIN_EMAILS=

# Telegram notifications
TELEGRAM_NOTIFIER_URL=

# MercadoPago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
