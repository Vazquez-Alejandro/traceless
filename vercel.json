{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/facturas/recordatorios",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/facturas/recordatorios-alejandro",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/facturas/recurrentes",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/facturas/recordatorio-monotributo",
      "schedule": "0 10 20 * *"
    },
    {
      "path": "/api/retry/process",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/facturas/procesar-programadas",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/facturas/verificar-certificados",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 4 * * *"
    }
  ]
}